{
  "name": "dsh-qq-panel",
  "version": "0.1.1",
  "private": false,
  "description": "给 DeepSeek Harness 上的 QQ 桥接（qq-bridge / OneBot v11）用的设置面板：人格卡编辑与热切换、表情包与备注管理、主动发言等行为参数、运行状态与日志。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "onebot",
    "qq-bridge",
    "persona",
    "panel"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "panel.html",
    "server.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "panel": "node server.mjs",
    "install:profile": "node scripts/install.mjs",
    "uninstall:profile": "node scripts/uninstall.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Beeasy-L/dsh-qq-panel.git"
  },
  "bugs": {
    "url": "https://github.com/Beeasy-L/dsh-qq-panel/issues"
  },
  "author": "Beeasy-L",
  "homepage": "https://github.com/Beeasy-L/dsh-qq-panel#readme"
}
